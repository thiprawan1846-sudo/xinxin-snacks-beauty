# ──────────────────────────────────────────────────────────────
# XinXin Snacks & Beauty — environment variables
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# ⚠️  NEVER commit real secrets. `.env` is gitignored. This file
#     contains ONLY placeholders — replace each value locally and
#     in your Vercel project settings (Project → Settings → Environment Variables).
# ──────────────────────────────────────────────────────────────

# ── Auth ──────────────────────────────────────────────────────
# Secret used to sign JWT session cookies.
# Generate a long random string: `openssl rand -base64 32`
# Used by: src/lib/auth.ts (signSession / verifySession)
JWT_SECRET=""

# ── Supabase (https://supabase.com) ───────────────────────────
# Get all values from: Supabase Dashboard → Project Settings → API
# Setup steps:
#   1. Create a project at https://supabase.com/dashboard
#   2. Fill in the four values below
#   3. Run `supabase/migrations/*.sql` in the Supabase SQL Editor
#   4. Run `npm run db:seed:rest` to load demo data (optional)

# PostgreSQL connection string (Project Settings → Database → Connection string).
# Used by: prisma/* (migrations, seed) — NOT used by the runtime app,
# which talks to Supabase via the REST API below.
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=""

# Supabase project URL (https://<project-ref>.supabase.co).
# Public — used by both server and client code.
NEXT_PUBLIC_SUPABASE_URL=""

# Supabase anon (public) key. Safe to expose; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase service_role key — FULL admin access, bypasses RLS.
# 🔒 SERVER-ONLY. Never expose to the client or put in NEXT_PUBLIC_*.
# Used by: src/lib/db.ts, src/app/api/admin/upload/route.ts
SUPABASE_SERVICE_ROLE_KEY=""

# ── App ───────────────────────────────────────────────────────
# Public site name (shown in footer, emails, etc.)
NEXT_PUBLIC_APP_NAME="XinXin Snacks & Beauty"

# Public canonical site URL. Used for SEO (metadataBase, sitemap, OG tags).
# Local dev: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
